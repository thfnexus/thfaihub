datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  MANAGER
}

enum Plan {
  FREE
  PRO
  PREMIUM
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?  @unique
  password  String
  name      String?
  role      Role     @default(USER)
  plan      Plan     @default(FREE)
  status    UserStatus @default(ACTIVE)
  credits   Int      @default(0)
  emailVerified     DateTime?
  verificationToken String?  @unique
  createdAt DateTime @default(now())
  logs      UsageLog[]
  payments  PaymentRequest[]
  tasks     RoutineTask[]
  performance DailyPerformance[]
  habits    HabitStreak[]
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  toolName  String
  creditsUsed Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Scholarship {
  id                  String   @id @default(cuid())
  name                String
  country             String
  eligible_countries  String[]
  degree_level        String
  field               String
  deadline            DateTime
  funding_amount      String
  eligibility_criteria String
  source_url          String
  last_verified       DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model PaymentRequest {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          String
  amount        Float
  transactionId String        @unique
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Routine Manager Models

model RoutineTask {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  deadline      DateTime?
  priority      String   // "urgent", "important", "normal"
  focusType     String   // "deep_work", "light_work", "creative"
  estimatedMins Int
  completed     Boolean  @default(false)
  completedAt   DateTime?
  scheduledFor  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DailyPerformance {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime
  hoursCompleted    Float
  distractionMins   Int
  focusScore        Int      // 0-100
  stressLevel       Int      // 1-10
  tasksCompleted    Int
  tasksPlanned      Int
  createdAt         DateTime @default(now())
  
  @@unique([userId, date])
}

model HabitStreak {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitType     String   // "daily_routine", "focus_time", "break_adherence"
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastCompletedDate DateTime?
  badges        String[] // array of earned badges
  level         Int      @default(1)
  xp            Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([userId, habitType])
}

